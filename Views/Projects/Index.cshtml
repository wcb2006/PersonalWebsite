@using PersonalWebsite.Models
@model List<Project>
@{
    var category = ViewData["Category"] as string;
    var heading = category switch
    {
        "school" => "Skolprojekt",
        "personal" => "Mina projekt",
        _ => "Alla projekt"
    };
    ViewData["Title"] = heading;
}

<section class="section">
    <div class="container">
        <div class="section-head reveal">
            <p class="eyebrow">Portfölj</p>
            <h2 class="section-title">@heading</h2>
            <p class="section-lead">
                @(Model.Any()
                    ? $"{Model.Count} projekt — klicka för att se koden eller den körande appen."
                    : "Här dyker projekten upp så fort de är publicerade.")
            </p>
        </div>

        <div class="tag-row reveal" style="margin-bottom:36px">
            <a class="@(category == null ? "tag tag--solid" : "tag")" asp-controller="Projects" asp-action="Index">Alla</a>
            <a class="@(category == "school" ? "tag tag--solid" : "tag")" asp-controller="Projects" asp-action="Index" asp-route-category="school">Skolprojekt</a>
            <a class="@(category == "personal" ? "tag tag--solid" : "tag")" asp-controller="Projects" asp-action="Index" asp-route-category="personal">Mina projekt</a>
        </div>

        @if (!Model.Any())
        {
            <div class="card" style="text-align:center;padding:56px 24px">
                <p class="card-text">Inga projekt i den här kategorin ännu.</p>
            </div>
        }
        else
        {
            <div class="project-grid">
                @foreach (var project in Model)
                {
                    <article class="card card--hover project-card reveal">
                        <div class="project-thumb">
                            @if (!string.IsNullOrEmpty(project.ImageUrl))
                            {
                                <img src="@project.ImageUrl" alt="@project.Title" loading="lazy" />
                            }
                            else
                            {
                                <div class="showcase-fallback"><i class="bi bi-code-slash"></i></div>
                            }
                            <span class="showcase-year">@project.Year</span>
                        </div>

                        <div class="project-body">
                            <div class="project-head">
                                <h3 class="card-title">@project.Title</h3>
                            </div>

                            <p class="card-text">@project.Description</p>

                            @if (!string.IsNullOrEmpty(project.Technologies))
                            {
                                <div class="tag-row">
                                    @foreach (var tech in project.Technologies.Split(','))
                                    {
                                        <span class="tag">@tech.Trim()</span>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(project.ProjectUrl))
                            {
                                <a class="btn-ghost btn-sm" href="@project.ProjectUrl" target="_blank" rel="noopener"
                                   style="align-self:flex-start">
                                    Visa projekt <span class="btn-arrow">&rarr;</span>
                                </a>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
