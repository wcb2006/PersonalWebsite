@using PersonalWebsite.Models
@model List<Project>
@{
    var category = ViewData["Category"] as string;
    var heading = category switch
    {
        "school" => Localizer["Skolprojekt"],
        "personal" => Localizer["Mina projekt"],
        _ => Localizer["Alla projekt"]
    };
    ViewData["Title"] = heading;
}

<section class="section">
    <div class="container">
        <div class="section-head reveal">
            <p class="eyebrow">@Localizer["Portfölj"]</p>
            <h2 class="section-title">@heading</h2>
            <p class="section-lead">
                @(Model.Any()
                    ? Localizer["{0} projekt — klicka för att se koden eller den körande appen.", Model.Count]
                    : Localizer["Här dyker projekten upp så fort de är publicerade."])
            </p>
        </div>

        <div class="tag-row reveal" style="margin-bottom:36px">
            <a class="@(category == null ? "tag tag--solid" : "tag")" asp-controller="Projects" asp-action="Index">@Localizer["Alla"]</a>
            <a class="@(category == "school" ? "tag tag--solid" : "tag")" asp-controller="Projects" asp-action="Index" asp-route-category="school">@Localizer["Skolprojekt"]</a>
            <a class="@(category == "personal" ? "tag tag--solid" : "tag")" asp-controller="Projects" asp-action="Index" asp-route-category="personal">@Localizer["Mina projekt"]</a>
        </div>

        @if (!Model.Any())
        {
            <div class="card" style="text-align:center;padding:56px 24px">
                <p class="card-text">@Localizer["Inga projekt i den här kategorin ännu."]</p>
            </div>
        }
        else
        {
            <div class="project-grid">
                @foreach (var project in Model)
                {
                    <article class="card card--hover project-card reveal">
                        <div class="project-thumb">
                            @if (!string.IsNullOrEmpty(project.ImageUrl))
                            {
                                <img src="@project.ImageUrl" alt="@LocalizedText.Pick(project.Title, project.TitleEn)" loading="lazy" />
                            }
                            else
                            {
                                <div class="showcase-fallback"><i class="bi bi-code-slash"></i></div>
                            }
                            <span class="showcase-year">@project.Year</span>
                        </div>

                        <div class="project-body">
                            <div class="project-head">
                                <h3 class="card-title">@LocalizedText.Pick(project.Title, project.TitleEn)</h3>
                            </div>

                            <p class="card-text">@LocalizedText.Pick(project.Description, project.DescriptionEn)</p>

                            @if (!string.IsNullOrEmpty(project.Technologies))
                            {
                                <div class="tag-row">
                                    @foreach (var tech in project.Technologies.Split(','))
                                    {
                                        <span class="tag">@tech.Trim()</span>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(project.ProjectUrl))
                            {
                                <a class="btn-ghost btn-sm" href="@project.ProjectUrl" target="_blank" rel="noopener"
                                   style="align-self:flex-start">
                                    @Localizer["Visa projekt"] <span class="btn-arrow">&rarr;</span>
                                </a>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
