@using PersonalWebsite.Models
@model ContactMessage
@{
    ViewData["Title"] = Localizer["Kontakt"];
}

<section class="section">
    <div class="container">
        <div class="split">
            <div class="card reveal" style="padding:clamp(24px, 4vw, 40px)">
                <p class="eyebrow">@Localizer["Skriv till mig"]</p>
                <h2 class="section-title" style="font-size:clamp(1.5rem,3vw,2rem)">@Localizer["Hör av dig"]</h2>
                <p class="section-lead" style="margin-bottom:28px">
                    @Localizer["Fyll i formuläret så återkommer jag så snart jag kan."]
                </p>

                <form asp-action="Index" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert-danger" role="alert"></div>

                    <div class="grid-2" style="gap:0 18px">
                        <div class="field">
                            <label asp-for="Name">@Localizer["Namn"]</label>
                            <input asp-for="Name" class="form-control" placeholder="@Localizer["Ditt namn"]" autocomplete="name" />
                            <span asp-validation-for="Name" class="field-error"></span>
                        </div>

                        <div class="field">
                            <label asp-for="Email">@Localizer["E-post"]</label>
                            <input asp-for="Email" class="form-control" placeholder="@Localizer["din@epost.se"]" autocomplete="email" />
                            <span asp-validation-for="Email" class="field-error"></span>
                        </div>
                    </div>

                    <div class="field">
                        <label asp-for="Subject">@Localizer["Ämne"]</label>
                        <input asp-for="Subject" class="form-control" placeholder="@Localizer["Vad gäller det?"]" />
                        <span asp-validation-for="Subject" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Message">@Localizer["Meddelande"]</label>
                        <textarea asp-for="Message" class="form-control" rows="6" placeholder="@Localizer["Skriv ditt meddelande här…"]"></textarea>
                        <span asp-validation-for="Message" class="field-error"></span>
                    </div>

                    <button type="submit" class="btn-solid btn-block" style="margin-top:8px">
                        @Localizer["Skicka meddelande"] <span class="btn-arrow">&rarr;</span>
                    </button>
                </form>
            </div>

            <aside class="stack">
                <div class="card reveal">
                    <p class="card-label">@Localizer["Direkt"]</p>
                    <ul class="info-list">
                        <li><span class="info-key">@Localizer["E-post"]</span><span class="info-val">wille.borg.c@@gmail.com</span></li>
                        <li><span class="info-key">@Localizer["Telefon"]</span><span class="info-val">070-582 82 22</span></li>
                        <li><span class="info-key">@Localizer["Ort"]</span><span class="info-val">@Localizer["Malmö, Sverige"]</span></li>
                    </ul>
                </div>

                <div class="card reveal">
                    <p class="card-label">@Localizer["Svarstid"]</p>
                    <p class="card-text">
                        <span class="hero-status" style="margin:0">
                            <span class="status-dot"></span> @Localizer["Oftast inom ett dygn"]
                        </span>
                    </p>
                </div>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
