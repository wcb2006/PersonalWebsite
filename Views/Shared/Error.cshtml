@model ErrorViewModel
@{
    ViewData["Title"] = Localizer["Något gick fel"];
}

<section class="section">
    <div class="container narrow">
        <div class="card" style="text-align:center;padding:clamp(40px, 7vw, 72px) 28px">
            <p class="eyebrow centered">@Localizer["Fel"]</p>
            <h1 class="section-title" style="font-size:clamp(1.8rem,4vw,2.6rem)">@Localizer["Något gick fel"]</h1>
            <p class="section-lead" style="margin:0 auto 28px">
                @Localizer["Ett oväntat fel uppstod när sidan skulle laddas. Försök igen om en stund."]
            </p>

            @if (Model.ShowRequestId)
            {
                <p class="card-text dim" style="margin-bottom:28px">
                    @Localizer["Referens:"] <code>@Model.RequestId</code>
                </p>
            }

            <div class="hero-actions" style="justify-content:center">
                <a class="btn-solid" asp-controller="Home" asp-action="Index">
                    @Localizer["Till startsidan"] <span class="btn-arrow">&rarr;</span>
                </a>
                <a class="btn-ghost" asp-controller="Contact" asp-action="Index">@Localizer["Rapportera problemet"]</a>
            </div>
        </div>
    </div>
</section>
