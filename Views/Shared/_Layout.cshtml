<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#08080a" />
    <meta name="description" content="William Borg – utvecklare från Malmö. Projekt, CV och kontakt." />
    <title>@ViewData["Title"] · William Borg</title>

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* Scroll-animationer aktiveras bara när JS finns — annars visas allt direkt. *@
    <script>document.documentElement.classList.add('js');</script>
</head>
<body>
    <header class="site-header">
        <nav class="container site-nav" aria-label="Huvudmeny">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">WB</span>
                <span>William Borg</span>
            </a>

            <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="navLinks" aria-label="Meny">
                <span></span>
            </button>

            <ul class="nav-links" id="navLinks">
                <li><a asp-controller="Home" asp-action="Index">Om mig</a></li>
                <li class="nav-drop">
                    <a asp-controller="Projects" asp-action="Index">Projekt</a>
                    <ul class="nav-drop-menu">
                        <li><a asp-controller="Projects" asp-action="Index">Alla projekt</a></li>
                        <li><a asp-controller="Projects" asp-action="Index" asp-route-category="school">Skolprojekt</a></li>
                        <li><a asp-controller="Projects" asp-action="Index" asp-route-category="personal">Mina projekt</a></li>
                    </ul>
                </li>
                <li><a asp-controller="Education" asp-action="Index">Utbildning</a></li>
                <li><a asp-controller="Cv" asp-action="Index">CV</a></li>
                <li><a asp-controller="Contact" asp-action="Index">Kontakt</a></li>
            </ul>
        </nav>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <p class="footer-tagline">Har du ett ärende?</p>
                    <p class="footer-sub">Hör gärna av dig — jag svarar oftast inom ett dygn.</p>
                </div>
                <div class="footer-links">
                    <a class="btn-solid btn-sm" asp-controller="Contact" asp-action="Index">
                        Kontakta mig <span class="btn-arrow">&rarr;</span>
                    </a>
                    <a class="btn-ghost btn-sm" asp-controller="Cv" asp-action="Index">Se CV</a>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; @DateTime.Now.Year William Borg</p>
                <p>Byggd med ASP.NET Core &amp; PostgreSQL</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
