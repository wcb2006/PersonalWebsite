@{
    ViewData["Title"] = "Integritetspolicy";
}

<section class="section">
    <div class="container narrow">
        <p class="eyebrow">Juridiskt</p>
        <h1 class="section-title">Integritetspolicy</h1>
        <p class="section-lead" style="margin-bottom:32px">
            Den här sidan samlar bara in det du själv skickar in via kontaktformuläret.
        </p>

        <div class="card stack">
            <div>
                <h2 class="card-title">Vad som sparas</h2>
                <p class="card-text">Namn, e-postadress, ämne och meddelande — samt tidpunkten då meddelandet skickades.</p>
            </div>
            <hr class="rule" />
            <div>
                <h2 class="card-title">Varför</h2>
                <p class="card-text">Uppgifterna används enbart för att kunna svara på ditt meddelande. De delas inte vidare.</p>
            </div>
            <hr class="rule" />
            <div>
                <h2 class="card-title">Vill du bli raderad?</h2>
                <p class="card-text">Hör av dig via kontaktsidan så tar jag bort dina uppgifter.</p>
            </div>
        </div>
    </div>
</section>
