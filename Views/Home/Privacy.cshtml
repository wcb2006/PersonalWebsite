@{
    ViewData["Title"] = Localizer["Integritetspolicy"];
}

<section class="section">
    <div class="container narrow">
        <p class="eyebrow">@Localizer["Juridiskt"]</p>
        <h1 class="section-title">@Localizer["Integritetspolicy"]</h1>
        <p class="section-lead" style="margin-bottom:32px">
            @Localizer["Den här sidan samlar bara in det du själv skickar in via kontaktformuläret."]
        </p>

        <div class="card stack">
            <div>
                <h2 class="card-title">@Localizer["Vad som sparas"]</h2>
                <p class="card-text">@Localizer["Namn, e-postadress, ämne och meddelande — samt tidpunkten då meddelandet skickades."]</p>
            </div>
            <hr class="rule" />
            <div>
                <h2 class="card-title">@Localizer["Varför"]</h2>
                <p class="card-text">@Localizer["Uppgifterna används enbart för att kunna svara på ditt meddelande. De delas inte vidare."]</p>
            </div>
            <hr class="rule" />
            <div>
                <h2 class="card-title">@Localizer["Vill du bli raderad?"]</h2>
                <p class="card-text">@Localizer["Hör av dig via kontaktsidan så tar jag bort dina uppgifter."]</p>
            </div>
        </div>
    </div>
</section>
