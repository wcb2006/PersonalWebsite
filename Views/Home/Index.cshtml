@using PersonalWebsite.ViewModels
@model HomeViewModel
@{
    ViewData["Title"] = Localizer["Om mig"];
    var about = Model.About;
    var projectCount = Model.Projects.Count;
    var latestYear = Model.Projects.Any() ? Model.Projects.Max(p => p.Year) : DateTime.Now.Year;

    // Hero visar första meningen; hela texten hamnar i "Om mig" längre ned.
    var aboutTitle = LocalizedText.Pick(about?.Title, about?.TitleEn);
    var bio = LocalizedText.Pick(about?.Bio, about?.BioEn)?.Trim() ?? string.Empty;
    var firstStop = bio.IndexOf(". ", StringComparison.Ordinal);
    var heroIntro = firstStop > 40 ? bio[..(firstStop + 1)] : bio;
    var hasMoreBio = heroIntro.Length < bio.Length;
}

<!-- ── Hero ─────────────────────────────────────────────────────────────── -->
<section class="hero">
    <div class="hero-glow hero-glow--a"></div>
    <div class="hero-glow hero-glow--b"></div>

    <div class="container hero-inner">
        <div>
            <span class="hero-status">
                <span class="status-dot"></span>
                @Localizer["Öppen för nya uppdrag"]
            </span>

            <h1 class="hero-title">
                @(string.IsNullOrEmpty(about?.Name) ? "William Borg" : about!.Name)<span class="dim">.</span>
            </h1>

            @if (!string.IsNullOrEmpty(aboutTitle))
            {
                <p class="eyebrow">@aboutTitle</p>
            }

            @if (!string.IsNullOrEmpty(heroIntro))
            {
                <p class="hero-bio">@heroIntro</p>
            }

            <div class="hero-actions">
                <a class="btn-solid" asp-controller="Projects" asp-action="Index">
                    @Localizer["Se mina projekt"] <span class="btn-arrow">&rarr;</span>
                </a>
                @if (!string.IsNullOrEmpty(about?.GithubUrl))
                {
                    <a class="btn-ghost" href="@about!.GithubUrl" target="_blank" rel="noopener">
                        <i class="bi bi-github"></i> GitHub
                    </a>
                }
                @if (!string.IsNullOrEmpty(about?.LinkedInUrl))
                {
                    <a class="btn-ghost" href="@about!.LinkedInUrl" target="_blank" rel="noopener">
                        <i class="bi bi-linkedin"></i> LinkedIn
                    </a>
                }
            </div>
        </div>

        <div class="hero-portrait">
            <img src="~/images/Profilepic.png" alt="@Localizer["Porträtt av William Borg"]" />
        </div>
    </div>
</section>

<!-- ── Nyckeltal ────────────────────────────────────────────────────────── -->
<div class="container">
    <div class="stat-row">
        <div class="stat">
            <p class="stat-value">@projectCount</p>
            <p class="stat-label">@Localizer["Projekt"]</p>
        </div>
        <div class="stat">
            <p class="stat-value">@latestYear</p>
            <p class="stat-label">@Localizer["Senaste bygget"]</p>
        </div>
        <div class="stat">
            <p class="stat-value">Malmö</p>
            <p class="stat-label">@Localizer["Baserad i"]</p>
        </div>
        <div class="stat">
            <p class="stat-value">C# &amp; .NET</p>
            <p class="stat-label">@Localizer["Främst i"]</p>
        </div>
    </div>
</div>

<!-- ── Om mig ───────────────────────────────────────────────────────────── -->
@if (hasMoreBio)
{
    <section class="section">
        <div class="container narrow reveal">
            <p class="eyebrow">@Localizer["Om mig"]</p>
            <h2 class="section-title">@Localizer["Bakom koden"]</h2>
            <p class="section-lead">@bio</p>
        </div>
    </section>
}

<!-- ── Kompetenser ──────────────────────────────────────────────────────── -->
<section class="section section--alt">
    <div class="container">
        <div class="section-head centered reveal">
            <p class="eyebrow centered">@Localizer["Verktygslåda"]</p>
            <h2 class="section-title">@Localizer["Teknik jag jobbar i"]</h2>
            <p class="section-lead">@Localizer["Språk och verktyg jag använder dagligen i skolan och i egna projekt."]</p>
        </div>

        @{
            var skills = new[]
            {
                new { Name = "Python",     Icon = "devicon-python-plain colored" },
                new { Name = "C#",         Icon = "devicon-csharp-plain colored" },
                new { Name = ".NET",       Icon = "devicon-dotnetcore-plain colored" },
                new { Name = "PostgreSQL", Icon = "devicon-postgresql-plain colored" },
                new { Name = "JavaScript", Icon = "devicon-javascript-plain colored" },
                new { Name = "Supabase",    Icon = "devicon-supabase-plain colored" },
                new { Name = "Git",        Icon = "devicon-git-plain colored" },
            };
        }

        <div class="skill-grid reveal">
            @foreach (var skill in skills)
            {
                <div class="skill">
                    <i class="@skill.Icon" aria-hidden="true"></i>
                    <span>@skill.Name</span>
                </div>
            }
        </div>
    </div>
</section>

<!-- ── Utvalda projekt ──────────────────────────────────────────────────── -->
@if (Model.Projects.Any())
{
    <section class="section">
        <div class="container">
            <div class="section-head flex-between reveal">
                <div>
                    <p class="eyebrow">@Localizer["Utvalt arbete"]</p>
                    <h2 class="section-title" style="margin-bottom:0">@Localizer["Mina projekt"]</h2>
                </div>
                <a class="btn-ghost btn-sm" asp-controller="Projects" asp-action="Index">
                    @Localizer["Alla projekt"] <span class="btn-arrow">&rarr;</span>
                </a>
            </div>

            <div class="slideshow reveal">
                @if (Model.Projects.Count > 1)
                {
                    <button class="slide-nav slide-nav--prev" type="button" data-slide="-1" aria-label="@Localizer["Föregående projekt"]">&#8592;</button>
                    <button class="slide-nav slide-nav--next" type="button" data-slide="1" aria-label="@Localizer["Nästa projekt"]">&#8594;</button>
                }

                <div class="slides-viewport">
                    <div class="slides-track" id="slidesTrack">
                        @foreach (var project in Model.Projects)
                        {
                            var hasLink = !string.IsNullOrEmpty(project.ProjectUrl);
                            <div class="slide">
                                @if (hasLink)
                                {
                                    <a class="showcase" href="@project.ProjectUrl" target="_blank" rel="noopener">
                                        @if (!string.IsNullOrEmpty(project.ImageUrl))
                                        {
                                            <img src="@project.ImageUrl" alt="@LocalizedText.Pick(project.Title, project.TitleEn)" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="showcase-fallback"><i class="bi bi-code-slash"></i></div>
                                        }
                                        <span class="showcase-year">@project.Year</span>
                                        <div class="showcase-overlay">
                                            @if (!string.IsNullOrEmpty(project.Technologies))
                                            {
                                                <div class="tag-row" style="margin-bottom:14px">
                                                    @foreach (var tech in project.Technologies.Split(','))
                                                    {
                                                        <span class="tag">@tech.Trim()</span>
                                                    }
                                                </div>
                                            }
                                            <h3>@LocalizedText.Pick(project.Title, project.TitleEn)</h3>
                                            <p>@LocalizedText.Pick(project.Description, project.DescriptionEn)</p>
                                            <span class="btn-solid btn-sm">@Localizer["Besök projekt"] <span class="btn-arrow">&rarr;</span></span>
                                        </div>
                                    </a>
                                }
                                else
                                {
                                    <div class="showcase">
                                        @if (!string.IsNullOrEmpty(project.ImageUrl))
                                        {
                                            <img src="@project.ImageUrl" alt="@LocalizedText.Pick(project.Title, project.TitleEn)" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="showcase-fallback"><i class="bi bi-code-slash"></i></div>
                                        }
                                        <span class="showcase-year">@project.Year</span>
                                        <div class="showcase-overlay">
                                            @if (!string.IsNullOrEmpty(project.Technologies))
                                            {
                                                <div class="tag-row" style="margin-bottom:14px">
                                                    @foreach (var tech in project.Technologies.Split(','))
                                                    {
                                                        <span class="tag">@tech.Trim()</span>
                                                    }
                                                </div>
                                            }
                                            <h3>@LocalizedText.Pick(project.Title, project.TitleEn)</h3>
                                            <p>@LocalizedText.Pick(project.Description, project.DescriptionEn)</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                @if (Model.Projects.Count > 1)
                {
                    <div class="slide-footer">
                        <div class="slide-dots" id="slideDots">
                            @for (int i = 0; i < Model.Projects.Count; i++)
                            {
                                <button class="dot @(i == 0 ? "is-active" : "")" type="button" data-index="@i"
                                        aria-label="@Localizer["Gå till projekt {0}", i + 1]"></button>
                            }
                        </div>
                        <span class="slide-counter"><span id="currentSlide">1</span> / @Model.Projects.Count</span>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- ── Snabblänkar ──────────────────────────────────────────────────────── -->
<section class="section section--alt">
    <div class="container">
        <div class="grid-3">
            <a class="card card--hover reveal" asp-controller="Projects" asp-action="Index">
                <p class="card-label"><i class="bi bi-code-slash"></i> 01</p>
                <h3 class="card-title">@Localizer["Alla projekt"]</h3>
                <p class="card-text">@Localizer["Skolprojekt och egna bygg, samlade på ett ställe."]</p>
            </a>
            <a class="card card--hover reveal" asp-controller="Cv" asp-action="Index">
                <p class="card-label"><i class="bi bi-file-earmark-text"></i> 02</p>
                <h3 class="card-title">CV</h3>
                <p class="card-text">@Localizer["Erfarenhet, utbildning och certifikat — även som PDF."]</p>
            </a>
            <a class="card card--hover reveal" asp-controller="Contact" asp-action="Index">
                <p class="card-label"><i class="bi bi-envelope"></i> 03</p>
                <h3 class="card-title">@Localizer["Kontakt"]</h3>
                <p class="card-text">@Localizer["Skicka ett meddelande så hör jag av mig."]</p>
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var track = document.getElementById('slidesTrack');
            if (!track) return;

            var total = track.children.length;
            var dots = Array.prototype.slice.call(document.querySelectorAll('#slideDots .dot'));
            var counter = document.getElementById('currentSlide');
            var current = 0;

            function goTo(n) {
                current = (n % total + total) % total;
                track.style.transform = 'translateX(-' + (current * 100) + '%)';
                dots.forEach(function (d, i) { d.classList.toggle('is-active', i === current); });
                if (counter) counter.textContent = current + 1;
            }

            document.querySelectorAll('[data-slide]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    goTo(current + Number(btn.dataset.slide));
                });
            });

            dots.forEach(function (d) {
                d.addEventListener('click', function () { goTo(Number(d.dataset.index)); });
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'ArrowRight') goTo(current + 1);
                if (e.key === 'ArrowLeft') goTo(current - 1);
            });

            var startX = null;
            track.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
            track.addEventListener('touchend', function (e) {
                if (startX === null) return;
                var diff = startX - e.changedTouches[0].clientX;
                if (Math.abs(diff) > 50) goTo(current + (diff > 0 ? 1 : -1));
                startX = null;
            }, { passive: true });
        })();
    </script>
}
